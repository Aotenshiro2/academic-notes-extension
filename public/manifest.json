{
  "manifest_version": 3,
  "name": "Le Carnet du Trader",
  "version": "1.8.0",
  "description": "Journalisez vos séances de trading sans interrompre votre analyse : notes, captures, trades et débriefs en quelques clics.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Le Carnet du Trader"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting",
    "identity",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Toggle Le Carnet du Trader sidebar"
    },
    "quick-capture": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Quick capture current page"
    }
  },
  "key": ""
}
